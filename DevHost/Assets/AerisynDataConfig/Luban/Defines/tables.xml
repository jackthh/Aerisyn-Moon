<?xml version="1.0" encoding="utf-8"?>
<!--
  DevHost Luban spike schema.
  Item: schema-from-file (##var/##type in items.csv).
  DemoNested: multi-row *levels; Level.bonus_stats uses list#sep (|).
-->
<module name="">
  <bean name="Level" sep=",">
    <var name="item_level" type="int"/>
    <var name="bonus_stats" type="(list#sep=\|),int"/>
    <var name="note" type="string?"/>
  </bean>

  <bean name="DemoNested">
    <var name="id" type="int"/>
    <var name="levels" type="(list#sep=;),Level"/>
  </bean>

  <table name="TbItem" value="Item" index="id" input="items.csv" readSchemaFromFile="1" comment="Flat items demo"/>
  <table name="TbDemoNested" value="DemoNested" index="id" input="demo_nested.csv" comment="Nested levels in compact sep cells"/>
</module>
